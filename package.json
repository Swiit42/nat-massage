{
  "name": "nat-massage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "npx prisma db push && npx tsx server/index.ts",
    "postinstall": "npx prisma generate",
    "build": "vite build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@vee-validate/zod": "^4.12.8",
    "@vueuse/core": "^10.11.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tsx": "^4.15.7",
    "googleapis": "^140.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^0.395.0",
    "nodemailer": "^6.9.14",
    "pinia": "^2.1.7",
    "radix-vue": "^1.9.0",
    "tailwind-merge": "^2.3.0",
    "vee-validate": "^4.12.8",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vue-tsc": "^2.0.22"
  }
}
